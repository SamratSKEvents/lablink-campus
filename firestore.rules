rules_version = '2';
// Least privilege. ALL client writes are denied: every write goes through the API,
// which validates input and enforces roles. Client reads exist only for live listeners.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isResponder() { return role() in ['technician', 'faculty', 'admin', 'security']; }

    // Live SOS / fault / welfare alerts for responders in the same department (security sees all).
    match /incidents/{id} {
      allow read: if signedIn() && isResponder()
        && (role() in ['admin', 'security'] || resource.data.departmentId == request.auth.token.dept);
    }

    // Students read only their own data.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /bookings/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /projects/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    // Evacuation plans: only the student. Responders see needs via the API, and only
    // while an incident for that student is active.
    match /evacuationPlans/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
