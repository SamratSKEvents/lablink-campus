# Copy to .env (gitignored) and fill in. Never commit real values.

# AI: Gemini is primary. Groq is the fallback. If both fail, deterministic templates are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DISABLED=0

# ID-card sign-in: HMAC secret for LL1.<cardId>.<version>.<sig> tokens (any long random string)
CARD_HMAC_SECRET=

# Firebase (server: Admin SDK). Locally, point to a service-account JSON; on Cloud Run, leave it blank.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase (client: web app config from Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
